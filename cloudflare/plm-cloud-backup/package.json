{
  "name": "plm-cloud-backup",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predeploy": "npm run ui:check && npm run admin:check && npm run remote:icons:check && npm run assets:check",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "db:create": "wrangler d1 create plm-cloud-backup-db",
    "db:migrate:remote": "wrangler d1 execute plm-cloud-backup-db --remote --file=./schema.sql",
    "db:migrate:local": "wrangler d1 execute plm-cloud-backup-db --local --file=./schema.sql",
    "ui:build": "node scripts/build-ui-styles.cjs",
    "ui:check": "node scripts/build-ui-styles.cjs --check",
    "assets:check": "node scripts/check-static-manifest.cjs",
    "remote:icons": "node scripts/build-remote-icons.cjs",
    "remote:icons:check": "node scripts/build-remote-icons.cjs --check",
    "admin:build": "node scripts/build-admin-styles.cjs",
    "admin:check": "node scripts/build-admin-styles.cjs --check",
    "assets:manifest": "npm run ui:check && node scripts/build-static-manifest.cjs",
    "brands:import": "node scripts/import-brand-compliance.cjs"
  },
  "devDependencies": {
    "lucide-react": "^0.468.0",
    "postcss": "^8.5.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "wrangler": "^4.20.5"
  }
}
