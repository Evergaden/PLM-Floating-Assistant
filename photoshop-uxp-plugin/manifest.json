{
  "manifestVersion": 5,
  "id": "com.violet.plm.photoshop-copywriting",
  "name": "PLM 文案助手",
  "version": "0.1.28",
  "main": "index.html",
  "host": {
    "app": "PS",
      "minVersion": "25.0.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "plm-copywriting-panel",
      "label": {
        "default": "PLM 文案助手"
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/plugin-dark.png",
          "scale": [1, 2],
          "theme": ["darkest", "dark"]
        },
        {
          "width": 23,
          "height": 23,
          "path": "icons/plugin-light.png",
          "scale": [1, 2],
          "theme": ["lightest", "light"]
        }
      ],
      "minimumSize": { "width": 280, "height": 460 },
      "maximumSize": { "width": 760, "height": 1400 },
      "preferredDockedSize": { "width": 360, "height": 720 },
      "preferredFloatingSize": { "width": 360, "height": 720 }
    }
  ],
  "icons": [
    {
      "width": 23,
      "height": 23,
      "path": "icons/plugin-dark.png",
      "scale": [1, 2],
      "theme": ["darkest", "dark"]
    },
    {
      "width": 23,
      "height": 23,
      "path": "icons/plugin-light.png",
      "scale": [1, 2],
      "theme": ["lightest", "light"]
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": "all"
    }
  }
}
